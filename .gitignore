# Ignore virtual environment folder
venv/

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore Jupyter Notebook checkpoints (if you use notebooks)
.ipynb_checkpoints/

# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore Python egg / build files
*.egg
*.egg-info/
dist/
build/
*.egg-info/

# Ignore logs
*.log

# Ignore IDE/editor configs (optional, for VSCode, PyCharm)
.vscode/
.idea/